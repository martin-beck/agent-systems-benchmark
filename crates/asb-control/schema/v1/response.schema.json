{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlResponse",
  "description": "JSON-RPC terminal response.",
  "oneOf": [
    {
      "description": "Successful typed response.",
      "$ref": "#/$defs/ControlSuccessResponse"
    },
    {
      "description": "Fixed privacy-safe failure response.",
      "$ref": "#/$defs/ControlFailureResponse"
    }
  ],
  "$defs": {
    "AnalysisSummary": {
      "description": "Privacy-safe aggregate analysis projection.",
      "type": "object",
      "properties": {
        "analysis_sha256": {
          "description": "Digest of the canonical analysis result stored as a sensitive artifact.",
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_count": {
          "description": "Number of runs included.",
          "type": "integer",
          "format": "uint16",
          "maximum": 256,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "run_count",
        "analysis_sha256"
      ]
    },
    "ArtifactMetadata": {
      "description": "Privacy-safe artifact metadata.",
      "type": "object",
      "properties": {
        "sensitivity": {
          "description": "Explicit sensitivity class.",
          "$ref": "#/$defs/ArtifactSensitivity"
        },
        "sha256": {
          "description": "Content digest, never a host path.",
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "description": "Byte length.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "sensitivity"
      ]
    },
    "ArtifactSensitivity": {
      "description": "Artifact sensitivity is explicit and content is never embedded in summaries.",
      "oneOf": [
        {
          "description": "Safe to expose through the ordinary control API.",
          "type": "string",
          "const": "public"
        },
        {
          "description": "Requires a separate least-privilege content authorization.",
          "type": "string",
          "const": "sensitive"
        }
      ]
    },
    "AttemptId": {
      "description": "Opaque stable execution-attempt identity.",
      "type": "string"
    },
    "BoundControlResult": {
      "description": "Successful result bound to the complete canonical request.",
      "type": "object",
      "properties": {
        "request_sha256": {
          "description": "SHA-256 of the canonical typed call.",
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "result": {
          "description": "Closed result body.",
          "$ref": "#/$defs/ControlResult"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "result"
      ]
    },
    "Capabilities": {
      "description": "Runner features exposed without embedding configuration or host details.",
      "type": "object",
      "properties": {
        "analysis": {
          "description": "Multiple runs can be analysed.",
          "type": "boolean"
        },
        "events": {
          "description": "Public event cursors are retained.",
          "type": "boolean"
        },
        "repeat": {
          "description": "Completed runs can be repeated.",
          "type": "boolean"
        },
        "run_control": {
          "description": "Plans can be created and launched.",
          "type": "boolean"
        },
        "validate_settings": {
          "description": "Settings can be validated without creating a plan.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "validate_settings",
        "run_control",
        "repeat",
        "analysis",
        "events"
      ]
    },
    "ControlEvent": {
      "description": "Privacy-reviewed public runner event.",
      "type": "object",
      "properties": {
        "attempt_id": {
          "description": "Related exact attempt when applicable.",
          "maxLength": 128,
          "minLength": 1,
          "oneOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "kind": {
          "description": "Event kind from the stable public vocabulary.",
          "$ref": "#/$defs/ControlEventKind"
        },
        "revision": {
          "description": "Durable contiguous revision.",
          "$ref": "#/$defs/Revision"
        },
        "run_id": {
          "description": "Related run when applicable.",
          "maxLength": 128,
          "minLength": 1,
          "oneOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "kind"
      ]
    },
    "ControlEventKind": {
      "description": "Stable privacy-safe runner event vocabulary.",
      "oneOf": [
        {
          "description": "Runner instance is ready after startup or recovery.",
          "type": "string",
          "const": "runner_ready"
        },
        {
          "description": "A validated plan became durable.",
          "type": "string",
          "const": "plan_created"
        },
        {
          "description": "An exact execution attempt started.",
          "type": "string",
          "const": "run_started"
        },
        {
          "description": "Durable public run state advanced.",
          "type": "string",
          "const": "run_updated"
        },
        {
          "description": "Required run evidence became durable.",
          "type": "string",
          "const": "run_completed"
        },
        {
          "description": "The run reached a durable failure.",
          "type": "string",
          "const": "run_failed"
        },
        {
          "description": "Cancellation reached a durable terminal state.",
          "type": "string",
          "const": "run_cancelled"
        },
        {
          "description": "The runner requires reconciliation before another effect.",
          "type": "string",
          "const": "reconciliation_required"
        }
      ]
    },
    "ControlFailureResponse": {
      "description": "Closed failed response envelope.",
      "type": "object",
      "properties": {
        "error": {
          "description": "Fixed privacy-safe error.",
          "$ref": "#/$defs/ControlRpcError"
        },
        "id": {
          "description": "Matching request identity.",
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "description": "Must equal `2.0`.",
          "type": "string",
          "const": "2.0"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ]
    },
    "ControlLimits": {
      "description": "Negotiated per-connection bounds.",
      "type": "object",
      "properties": {
        "max_frame_bytes": {
          "description": "Largest four-byte-length-prefixed JSON body.",
          "type": "integer",
          "format": "uint32",
          "maximum": 1048576,
          "minimum": 1
        },
        "max_in_flight": {
          "description": "Largest number of admitted requests awaiting terminal responses.",
          "type": "integer",
          "format": "uint16",
          "maximum": 64,
          "minimum": 1
        },
        "max_page_items": {
          "description": "Largest page a client may request.",
          "type": "integer",
          "format": "uint16",
          "maximum": 256,
          "minimum": 1
        },
        "max_timeout_ms": {
          "description": "Longest request processing deadline measured from receipt.",
          "type": "integer",
          "format": "uint64",
          "maximum": 300000,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "max_frame_bytes",
        "max_timeout_ms",
        "max_page_items",
        "max_in_flight"
      ]
    },
    "ControlResult": {
      "description": "Closed allowlist of successful results returned by runner backends.",
      "oneOf": [
        {
          "description": "Runner feature availability.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "capabilities"
            },
            "value": {
              "$ref": "#/$defs/Capabilities"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Settings validation outcome.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settings_validation"
            },
            "value": {
              "$ref": "#/$defs/SettingsValidation"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Created or repeated immutable plan.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan"
            },
            "value": {
              "$ref": "#/$defs/PlanReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Launch returned its durable run identity.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "launch"
            },
            "value": {
              "$ref": "#/$defs/RunSummary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Current durable run state.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "status"
            },
            "value": {
              "$ref": "#/$defs/RunSummary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Cancellation or another mutation was durably accepted.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "acknowledged"
            },
            "value": {
              "$ref": "#/$defs/MutationAcknowledgement"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Recent run page.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "history"
            },
            "value": {
              "$ref": "#/$defs/Page"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Public event page.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "events"
            },
            "value": {
              "$ref": "#/$defs/Page2"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Aggregate analysis metadata.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "analysis"
            },
            "value": {
              "$ref": "#/$defs/AnalysisSummary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Artifact metadata without content or host paths.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact_metadata"
            },
            "value": {
              "$ref": "#/$defs/ArtifactMetadata"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ControlRpcError": {
      "description": "Privacy-safe JSON-RPC error.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable machine-readable code.",
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "description": "Bounded public diagnostic.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ControlSuccess": {
      "description": "Closed wire-visible success envelope.",
      "oneOf": [
        {
          "description": "Initial protocol negotiation.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "negotiated"
            },
            "value": {
              "$ref": "#/$defs/Negotiated"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Result of one post-negotiation operation.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "operation"
            },
            "value": {
              "$ref": "#/$defs/BoundControlResult"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "ControlSuccessResponse": {
      "description": "Closed successful response envelope.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Matching request identity.",
          "$ref": "#/$defs/RequestId"
        },
        "jsonrpc": {
          "description": "Must equal `2.0`.",
          "type": "string",
          "const": "2.0"
        },
        "result": {
          "description": "Closed successful result.",
          "$ref": "#/$defs/ControlSuccess"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    "ControlVersion": {
      "description": "A major/minor protocol version.",
      "type": "object",
      "properties": {
        "major": {
          "description": "Breaking protocol generation.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minor": {
          "description": "Backward-compatible feature generation.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ]
    },
    "MutationAcknowledgement": {
      "description": "Stable acknowledgement for an accepted durable mutation.",
      "type": "object",
      "properties": {
        "accepted": {
          "description": "The mutation is durably accepted.",
          "type": "boolean",
          "const": true
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted"
      ]
    },
    "Negotiated": {
      "description": "Negotiated connection result.",
      "type": "object",
      "properties": {
        "latest_revision": {
          "description": "Latest retained public event revision.",
          "$ref": "#/$defs/Revision"
        },
        "limits": {
          "description": "Effective bounds.",
          "$ref": "#/$defs/ControlLimits"
        },
        "oldest_revision": {
          "description": "Oldest retained public event revision.",
          "$ref": "#/$defs/Revision"
        },
        "runner_instance_id": {
          "description": "Stable runner instance identity.",
          "type": "string"
        },
        "version": {
          "description": "Selected protocol version.",
          "$ref": "#/$defs/ControlVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "limits",
        "runner_instance_id",
        "oldest_revision",
        "latest_revision"
      ]
    },
    "Page": {
      "description": "Bounded event or history page.",
      "type": "object",
      "properties": {
        "has_more": {
          "description": "Whether a later retained record exists.",
          "type": "boolean"
        },
        "items": {
          "description": "Ordered page records.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunSummary"
          },
          "maxItems": 256
        },
        "next": {
          "description": "Cursor representing the final returned record.",
          "oneOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "items",
        "has_more"
      ]
    },
    "Page2": {
      "description": "Bounded event or history page.",
      "type": "object",
      "properties": {
        "has_more": {
          "description": "Whether a later retained record exists.",
          "type": "boolean"
        },
        "items": {
          "description": "Ordered page records.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlEvent"
          },
          "maxItems": 256
        },
        "next": {
          "description": "Cursor representing the final returned record.",
          "oneOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "items",
        "has_more"
      ]
    },
    "PlanReference": {
      "description": "Durable immutable plan identity.",
      "type": "object",
      "properties": {
        "plan_id": {
          "description": "Opaque stable plan identity.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "plan_sha256": {
          "description": "SHA-256 of the canonical plan.",
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "plan_id",
        "plan_sha256"
      ]
    },
    "PublicRunState": {
      "description": "Public run lifecycle; absence is never encoded as a successful state.",
      "oneOf": [
        {
          "description": "Definition is durable but execution has not started.",
          "type": "string",
          "const": "planned"
        },
        {
          "description": "Inputs are prepared.",
          "type": "string",
          "const": "prepared"
        },
        {
          "description": "Execution is active.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Evidence collection is active.",
          "type": "string",
          "const": "collecting"
        },
        {
          "description": "All required evidence is durable.",
          "type": "string",
          "const": "completed"
        },
        {
          "description": "Execution or collection failed.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Cancellation reached a durable terminal state.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "External effects require runner-side reconciliation.",
          "type": "string",
          "const": "needs_reconciliation"
        }
      ]
    },
    "RequestId": {
      "description": "Numeric JSON-RPC request identity.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Revision": {
      "description": "Opaque durable revision used to resume event streams.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "RunId": {
      "description": "Opaque stable run identity.",
      "type": "string"
    },
    "RunSummary": {
      "description": "Privacy-reviewed run summary.",
      "type": "object",
      "properties": {
        "attempt_id": {
          "description": "Exact attempt identity.",
          "$ref": "#/$defs/AttemptId",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "created_revision": {
          "description": "Immutable revision at which this run first entered the journal.",
          "$ref": "#/$defs/Revision"
        },
        "plan_sha256": {
          "description": "Content digest of the immutable plan.",
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "description": "Durable revision from which this summary was derived.",
          "$ref": "#/$defs/Revision"
        },
        "run_id": {
          "description": "Stable run identity.",
          "$ref": "#/$defs/RunId",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "state": {
          "description": "State derived from the authoritative journal.",
          "$ref": "#/$defs/PublicRunState"
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "attempt_id",
        "state",
        "created_revision",
        "revision",
        "plan_sha256"
      ]
    },
    "SettingsIssue": {
      "description": "Stable, non-sensitive settings diagnostic.",
      "oneOf": [
        {
          "description": "The settings shape or syntax is invalid.",
          "type": "string",
          "const": "invalid_format"
        },
        {
          "description": "A requested capability is unavailable.",
          "type": "string",
          "const": "unsupported_capability"
        },
        {
          "description": "A referenced immutable component cannot be verified.",
          "type": "string",
          "const": "unverified_component"
        },
        {
          "description": "A configured resource bound is invalid.",
          "type": "string",
          "const": "invalid_resource_bound"
        }
      ]
    },
    "SettingsValidation": {
      "description": "Privacy-safe settings validation outcome.",
      "type": "object",
      "properties": {
        "issues": {
          "description": "Bounded stable issue vocabulary, without copied input values.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SettingsIssue"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "valid": {
          "description": "Whether plan creation may proceed.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "issues": {
                  "maxItems": 0
                },
                "valid": {
                  "const": true
                }
              }
            },
            {
              "properties": {
                "issues": {
                  "minItems": 1
                },
                "valid": {
                  "const": false
                }
              }
            }
          ]
        }
      ],
      "required": [
        "valid",
        "issues"
      ]
    }
  }
}
