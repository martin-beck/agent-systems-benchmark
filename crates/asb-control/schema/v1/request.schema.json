{
  "$defs": {
    "AttemptId": {
      "description": "Opaque stable execution-attempt identity.",
      "type": "string"
    },
    "CancelParams": {
      "additionalProperties": false,
      "description": "Causally fenced cancellation input.",
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/AttemptId",
          "description": "Exact attempt expected by the frontend.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "idempotency_key": {
          "description": "Opaque key retained by the runner to make retries safe.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "run_id": {
          "$ref": "#/$defs/RunId",
          "description": "Run to cancel.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "idempotency_key"
      ],
      "type": "object"
    },
    "ControlLimits": {
      "additionalProperties": false,
      "description": "Negotiated per-connection bounds.",
      "properties": {
        "max_frame_bytes": {
          "description": "Largest four-byte-length-prefixed JSON body.",
          "format": "uint32",
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "max_in_flight": {
          "description": "Largest number of admitted requests awaiting terminal responses.",
          "format": "uint16",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "max_page_items": {
          "description": "Largest page a client may request.",
          "format": "uint16",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "max_timeout_ms": {
          "description": "Longest request processing deadline measured from receipt.",
          "format": "uint64",
          "maximum": 300000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_frame_bytes",
        "max_timeout_ms",
        "max_page_items",
        "max_in_flight"
      ],
      "type": "object"
    },
    "ControlVersion": {
      "additionalProperties": false,
      "description": "A major/minor protocol version.",
      "properties": {
        "major": {
          "description": "Breaking protocol generation.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "description": "Backward-compatible feature generation.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "LaunchParams": {
      "additionalProperties": false,
      "description": "Idempotent launch input.",
      "properties": {
        "idempotency_key": {
          "description": "Opaque key retained by the runner to make retries safe.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "plan_id": {
          "description": "Previously created durable plan identity.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "plan_id"
      ],
      "type": "object"
    },
    "MutationParams": {
      "additionalProperties": false,
      "description": "Generic idempotent mutation input.",
      "properties": {
        "definition": {
          "description": "Content-pinned validated definition."
        },
        "idempotency_key": {
          "description": "Opaque key retained by the runner to make retries safe.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "definition"
      ],
      "type": "object"
    },
    "NegotiateParams": {
      "additionalProperties": false,
      "description": "Initial negotiation offer.",
      "properties": {
        "limits": {
          "$ref": "#/$defs/ControlLimits",
          "description": "Client-side bounds."
        },
        "versions": {
          "description": "Versions supported by the client.",
          "items": {
            "$ref": "#/$defs/ControlVersion"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "versions",
        "limits"
      ],
      "type": "object"
    },
    "PageParams": {
      "additionalProperties": false,
      "description": "Bounded cursor page request.",
      "properties": {
        "after": {
          "description": "Last revision already durably observed, or none for the retained beginning.",
          "oneOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "Maximum requested records.",
          "format": "uint16",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "RepeatParams": {
      "additionalProperties": false,
      "description": "Repetition input bound to an immutable source run.",
      "properties": {
        "idempotency_key": {
          "description": "Opaque key retained by the runner to make retries safe.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "run_id": {
          "$ref": "#/$defs/RunId",
          "description": "Immutable source run.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "required": [
        "run_id",
        "idempotency_key"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "Numeric JSON-RPC request identity.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "Revision": {
      "description": "Opaque durable revision used to resume event streams.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "RunId": {
      "description": "Opaque stable run identity.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON-RPC request accepted from a frontend.",
  "oneOf": [
    {
      "description": "Negotiate protocol version and resource bounds.",
      "properties": {
        "method": {
          "const": "negotiate",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/NegotiateParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Obtain runner and transport capabilities.",
      "properties": {
        "method": {
          "const": "capabilities",
          "type": "string"
        }
      },
      "required": [
        "method"
      ],
      "type": "object"
    },
    {
      "description": "Validate settings without creating durable run state.",
      "properties": {
        "method": {
          "const": "validate_settings",
          "type": "string"
        },
        "params": {
          "properties": {
            "settings": {
              "description": "Candidate settings document."
            }
          },
          "required": [
            "settings"
          ],
          "type": "object"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Validate and durably create a content-pinned plan.",
      "properties": {
        "method": {
          "const": "create_plan",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MutationParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Launch one previously created plan.",
      "properties": {
        "method": {
          "const": "launch",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/LaunchParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Read authoritative current run state.",
      "properties": {
        "method": {
          "const": "status",
          "type": "string"
        },
        "params": {
          "properties": {
            "run_id": {
              "$ref": "#/$defs/RunId",
              "description": "Durable run to inspect."
            }
          },
          "required": [
            "run_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Request cancellation of an exact attempt.",
      "properties": {
        "method": {
          "const": "cancel",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/CancelParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Page through recent durable runs.",
      "properties": {
        "method": {
          "const": "history",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PageParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Create a new plan from a completed run.",
      "properties": {
        "method": {
          "const": "repeat",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RepeatParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Analyze a bounded set of durable runs.",
      "properties": {
        "method": {
          "const": "analyze",
          "type": "string"
        },
        "params": {
          "properties": {
            "run_ids": {
              "description": "Bounded set of durable runs to compare.",
              "items": {
                "$ref": "#/$defs/RunId"
              },
              "type": "array"
            }
          },
          "required": [
            "run_ids"
          ],
          "type": "object"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Resume public runner events after a durable revision.",
      "properties": {
        "method": {
          "const": "events",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PageParams"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "description": "Obtain metadata for one sensitive artifact; content needs separate authorization.",
      "properties": {
        "method": {
          "const": "artifact_metadata",
          "type": "string"
        },
        "params": {
          "properties": {
            "digest": {
              "description": "Exact content digest from the runner journal.",
              "type": "string"
            },
            "run_id": {
              "$ref": "#/$defs/RunId",
              "description": "Durable run owning the artifact reference."
            }
          },
          "required": [
            "run_id",
            "digest"
          ],
          "type": "object"
        }
      },
      "required": [
        "method",
        "params"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/RequestId",
      "description": "Unique outstanding request identity on this connection."
    },
    "jsonrpc": {
      "const": "2.0",
      "description": "Must equal `2.0`.",
      "type": "string"
    },
    "timeout_ms": {
      "description": "Deadline relative to server receipt.",
      "format": "uint64",
      "maximum": 300000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "timeout_ms"
  ],
  "title": "ControlRequest",
  "type": "object",
  "unevaluatedProperties": false
}
