{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASB strict replay launch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cassette_sha256", "route_sha256", "provider_dialect", "adapter", "run_id", "attempt_id", "workload_sha256", "egress", "timeout_ms"],
  "properties": {
    "schema_version": {"const": 1},
    "cassette_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_dialect": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "egress": {"const": "loopback_only"},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
  }
}
