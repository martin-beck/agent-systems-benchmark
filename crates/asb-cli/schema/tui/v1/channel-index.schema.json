{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-systems-benchmark/blob/main/crates/asb-cli/schema/tui/v1/channel-index.schema.json",
  "title": "ASB TUI signed stable channel index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issued_unix", "expires_unix", "releases"],
  "properties": {
    "schema_version": { "const": 1 },
    "issued_unix": { "type": "integer", "minimum": 0 },
    "expires_unix": { "type": "integer", "minimum": 0 },
    "releases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["release", "target", "asb_version", "protocol_version", "manifest_url", "manifest_signature_url", "manifest_sha256"],
        "properties": {
          "release": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
          "target": { "enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"] },
          "asb_version": { "const": "0.1.0" },
          "protocol_version": { "const": 1 },
          "manifest_url": { "type": "string", "pattern": "^https://github\\.com/martin-beck/asb-tui/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/manifest\\.json$" },
          "manifest_signature_url": { "type": "string", "pattern": "^https://github\\.com/martin-beck/asb-tui/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/manifest\\.json\\.sig$" },
          "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
