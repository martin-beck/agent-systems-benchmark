{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asb.example.invalid/schema/cli/adapter-catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "command", "catalog_version", "catalog_sha256", "adapters"],
  "properties": {
    "schema_version": {"const": 1}, "ok": {"const": true}, "command": {"const": "adapter-catalog"},
    "catalog_version": {"const": 1}, "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapters": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "providers", "model_constraint", "authentication_reference", "availability", "diagnostic"],
      "properties": {"id": {"type": "string", "pattern": "^agent\\.[a-z][a-z0-9-]{0,63}$"}, "providers": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "minItems": 1, "uniqueItems": true}, "model_constraint": {"type": "string", "minLength": 1}, "authentication_reference": {"type": "string", "minLength": 1}, "availability": {"type": "string", "minLength": 1}, "diagnostic": {"type": "string", "minLength": 1}}
    }}
  }
}
