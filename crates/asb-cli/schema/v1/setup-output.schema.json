{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asb.example.invalid/schema/cli/setup-output-v1.json",
  "title": "ASB setup preflight output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "command", "mode", "steps", "persistent_change", "provider_contact", "provider_profile", "model", "agents", "providers", "models", "default_agent", "default_provider", "default_model", "authentication"],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"const": true},
    "command": {"const": "setup"},
    "mode": {"enum": ["preflight", "commit"]},
    "steps": {"type": "array", "const": ["detect-installed-agents", "select-provider-and-model", "configure-authentication", "confirm-persistence"]},
    "persistent_change": {"type": "boolean"},
    "provider_contact": {"const": false},
    "provider_profile": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "agents": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true, "minItems": 1},
    "providers": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true, "minItems": 1},
    "models": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true, "minItems": 1},
    "default_agent": {"type": "string", "minLength": 1, "maxLength": 128},
    "default_provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "default_model": {"type": "string", "minLength": 1, "maxLength": 128},
    "authentication": {
      "type": "object", "additionalProperties": false,
      "required": ["development_only", "status", "warning"],
      "properties": {
        "development_only": {"const": true},
        "status": {"const": "unavailable"},
        "warning": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
