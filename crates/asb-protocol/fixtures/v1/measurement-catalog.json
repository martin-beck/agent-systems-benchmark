      "label": "Scheduling and contention",
      "description": "Pressure and throttling signals that do not by themselves establish causation."
    },
    {
      "id": "latency",
      "label": "Latency",
      "description": "Queue, readiness, response, and completion timing evidence."
    },
    {
      "id": "quality_reliability",
      "label": "Quality and reliability",
      "description": "Independent correctness, failure, timeout, retry, and cancellation evidence."
    },
    {
      "id": "fairness",
      "label": "Fairness",
      "description": "Per-agent and mixed-workload service distribution evidence."
    },
    {
      "id": "cost",
      "label": "Cost",
      "description": "Provider-reported monetary evidence with explicit absence semantics."
    },
    {
      "id": "provenance",
      "label": "Provenance",
      "description": "Harness, collector, replay, and experiment identity evidence."
    }
  ],
