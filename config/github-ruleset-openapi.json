{
  "schema_version": 1,
  "api_version": "2022-11-28",
  "source_commit": "7dee0622aeecf9df3c5060ca28c7a57ee5007804",
  "source_blob": "63926c4dc629284e7d29ecc9de9938bf4ac0fd82",
  "source_sha256": "0d2fa885d4a15f57a6fe06811cbd13e7e0f580d292530199db1a59cfc2b7d14e",
  "source_path": "descriptions/api.github.com/api.github.com.2022-11-28.json",
  "create_ruleset_schema": {
    "type": "object",
    "required": ["name", "target", "enforcement", "bypass_actors", "conditions", "rules"],
    "additionalProperties": false,
    "properties": {
      "name": {"type": "string", "minLength": 1},
      "target": {"type": "string", "enum": ["branch", "tag", "push"]},
      "enforcement": {"type": "string", "enum": ["disabled", "active", "evaluate"]},
      "bypass_actors": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["actor_type"],
          "additionalProperties": false,
          "properties": {
            "actor_id": {"type": ["integer", "null"]},
            "actor_type": {"type": "string", "enum": ["Integration", "OrganizationAdmin", "RepositoryRole", "Team", "DeployKey", "User"]},
            "bypass_mode": {"type": "string", "enum": ["always", "pull_request", "exempt"]}
          }
        }
      },
      "conditions": {
        "type": "object",
        "required": ["ref_name"],
        "additionalProperties": false,
        "properties": {
          "ref_name": {
            "type": "object",
            "required": ["include", "exclude"],
            "additionalProperties": false,
            "properties": {
              "include": {"type": "array", "items": {"type": "string"}},
              "exclude": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      },
      "rules": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"type": "string", "enum": ["deletion"]}}},
            {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"type": "string", "enum": ["non_fast_forward"]}}},
            {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"type": "string", "enum": ["required_signatures"]}}},
            {
              "type": "object",
              "required": ["type", "parameters"],
              "additionalProperties": false,
              "properties": {
                "type": {"type": "string", "enum": ["pull_request"]},
                "parameters": {
                  "type": "object",
                  "required": ["allowed_merge_methods", "dismiss_stale_reviews_on_push", "require_code_owner_review", "require_last_push_approval", "required_approving_review_count", "required_review_thread_resolution"],
                  "additionalProperties": false,
                  "properties": {
                    "allowed_merge_methods": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["merge", "squash", "rebase"]}},
                    "dismiss_stale_reviews_on_push": {"type": "boolean"},
                    "require_code_owner_review": {"type": "boolean"},
                    "require_last_push_approval": {"type": "boolean"},
                    "required_approving_review_count": {"type": "integer", "minimum": 0, "maximum": 10},
                    "required_review_thread_resolution": {"type": "boolean"}
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "parameters"],
              "additionalProperties": false,
              "properties": {
                "type": {"type": "string", "enum": ["required_status_checks"]},
                "parameters": {
                  "type": "object",
                  "required": ["required_status_checks", "strict_required_status_checks_policy", "do_not_enforce_on_create"],
                  "additionalProperties": false,
                  "properties": {
                    "required_status_checks": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["context"],
                        "additionalProperties": false,
                        "properties": {
                          "context": {"type": "string", "minLength": 1},
                          "integration_id": {"type": "integer"}
                        }
                      }
                    },
                    "strict_required_status_checks_policy": {"type": "boolean"},
                    "do_not_enforce_on_create": {"type": "boolean"}
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "parameters"],
              "additionalProperties": false,
              "properties": {
                "type": {"type": "string", "enum": ["committer_email_pattern"]},
                "parameters": {
                  "type": "object",
                  "required": ["name", "negate", "operator", "pattern"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "negate": {"type": "boolean"},
                    "operator": {"type": "string", "enum": ["starts_with", "ends_with", "contains", "regex"]},
                    "pattern": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
