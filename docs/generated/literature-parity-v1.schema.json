{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASB literature documentation parity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_documents", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "source_documents": {
      "type": "array",
      "const": ["WORKLOADS.md", "RELATED_WORK.md", "PLAN.md"]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "registry_id", "family", "kind", "source_revision", "dataset_revision", "license", "license_state", "evaluator", "evaluator_state", "evidence_status", "selectable", "framework_boundary"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "registry_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "family": {"type": "string", "minLength": 1},
        "kind": {"enum": ["workload", "framework"]},
        "source_revision": {"type": "string", "minLength": 1},
        "dataset_revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "license_state": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "evaluator_state": {"type": "string", "minLength": 1},
        "evidence_status": {"type": "string", "minLength": 1},
        "selectable": {"type": "boolean"},
        "framework_boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
