{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-systems-benchmark/tools/tutorials/schema/v1/tutorial.schema.json",
  "title": "ASB offline tutorial v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tutorial_id", "title", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "tutorial_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command", "expect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
        "command": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "expect": {
          "type": "object", "additionalProperties": false,
          "required": ["exit_code", "stdout_shape"],
          "properties": {
            "exit_code": {"type": "integer", "minimum": 0, "maximum": 125},
            "stdout_shape": {"type": "string", "minLength": 1, "maxLength": 64}
          }
        },
        "references": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/reference"}},
        "network": {"const": "denied"},
        "credentials": {"const": "none"}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["input", "output", "config", "fixture"]}
      }
    }
  }
}
