{
  "schema_version": 1,
  "tutorial_id": "benchmark-readiness",
  "title": "Offline benchmark readiness check",
  "steps": [
    {
      "id": "inspect-doctor",
      "command": ["asb", "doctor"],
      "expect": {"exit_code": 0, "stdout_shape": "doctor-v1"},
      "network": "denied",
      "credentials": "none"
    },
    {
      "id": "inspect-capabilities",
      "command": ["asb", "capabilities", "--format", "json"],
      "expect": {"exit_code": 0, "stdout_shape": "capabilities-v1"},
      "network": "denied",
      "credentials": "none"
    },
    {
      "id": "inspect-workload-catalog",
      "command": ["asb", "workload-catalog"],
      "expect": {"exit_code": 0, "stdout_shape": "workload-catalog-v1"},
      "network": "denied",
      "credentials": "none"
    },
    {
      "id": "inspect-provider-catalog",
      "command": ["asb", "provider-catalog"],
      "expect": {"exit_code": 0, "stdout_shape": "provider-catalog-v1"},
      "network": "denied",
      "credentials": "none"
    },
    {
      "id": "validate-provider-config",
      "command": [
        "asb", "setup", "--provider-profile", "openrouter", "--model",
        "deepseek/deepseek-chat-v3-0324:free", "--output", "benchmark-readiness.json"
      ],
      "expect": {"exit_code": 0, "stdout_shape": "setup-v1"},
      "references": [{"path": "benchmark-readiness.json", "kind": "output"}],
      "network": "denied",
      "credentials": "none"
    },
    {
      "id": "plan-agent-selection",
      "command": [
        "asb", "provider-plan", "--catalog-sha256",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "--provider-profile", "openrouter", "--credential-reference-sha256",
        "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
        "--agent", "codex"
      ],
      "expect": {"exit_code": 0, "stdout_shape": "provider-plan-v1"},
      "references": [{"path": "benchmark-selection.json", "kind": "output"}],
      "network": "denied",
      "credentials": "none"
    },
    {
      "id": "validate-benchmark-plan",
      "command": [
        "asb", "plan", "benchmark-experiment.toml",
        "--provider-selection", "benchmark-selection.json"
      ],
      "expect": {"exit_code": 0, "stdout_shape": "plan-v1"},
      "references": [
        {"path": "benchmark-experiment.toml", "kind": "input"},
        {"path": "benchmark-selection.json", "kind": "input"}
      ],
      "network": "denied",
      "credentials": "none"
    }
  ]
}
