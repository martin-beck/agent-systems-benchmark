{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-systems-benchmark.example/schema/synthetic-llm-scenario-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "evidence_origin", "protocol", "seed", "events"],
  "properties": {
    "schema_version": {"const": 1}, "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "evidence_origin": {"const": "synthetic"}, "protocol": {"enum": ["openai-chat", "openai-responses", "anthropic-messages"]},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "events": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {"event": {"type": "object", "additionalProperties": false, "required": ["sequence", "session", "kind", "payload"], "properties": {
    "sequence": {"type": "integer", "minimum": 0, "maximum": 63}, "session": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,31}$"},
    "kind": {"enum": ["request", "buffered", "sse", "tool_call", "tool_result", "fault", "cancelled", "completed"]}, "payload": {"type": "object", "maxProperties": 32}
  }}}
}
